# Workspace assigned to new Leon sessions. The Windows installer may replace
# this value with the directory selected during installation.
LEON_DEFAULT_WORKSPACE=E:/computador

# Keep provider credentials in the Leon credential settings or a private .env.
# Never commit real API keys.

# FreeLLMAPI (loopback router on local machine):
# run your local FreeLLMAPI gateway at 127.0.0.1:31415 and set its unified token below.
FREELLMAPI_API_KEY=

# Optional cloud keys (populate only if each provider is enabled):
GOOGLE_API_KEY=
OPENAI_API_KEY=
NVIDIA_API_KEY=
